# ── ARCHIVO DE EJEMPLO DE VARIABLES DE TERRAFORM ─────────────
# Renombra este archivo a 'terraform.tfvars' para personalizarlo

aws_region          = "us-east-1"
project_name        = "botmare"
environment         = "production"
instance_type       = "t3.small"   # Recomendado: t3.small (2 GB RAM) o t3.medium
disk_size_gb        = 30
key_name            = ""          # Nombre de tu Key Pair SSH en AWS (opcional)
allocate_elastic_ip = true
github_repo_url     = "https://github.com/LedezmaSune/BotMaRe.git"
