# 🦊 BotMaRe AI - Plantilla de Configuración
# Copia este archivo como .env y ejecuta: pnpm run setup:secrets

# ── SISTEMA Y RED ──────────────────────────────────────────────
PORT=8000
DASHBOARD_URL=http://localhost:8000
# Si usas un túnel permanente (ej. Cloudflare Zero Trust) y no el Quick Tunnel temporal, pon el dominio aquí:
CUSTOM_DOMAIN=""
NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=""
TRUST_PROXY=false

# ── SEGURIDAD DEL DASHBOARD Y ACCESOS ──────────────────────────
# Usuario y contraseña para acceder a la interfaz web (localhost:8000)
DASHBOARD_USER=admin
DASHBOARD_PASS=CAMBIA_ESTO_genera_con_pnpm_run_setup_secrets
# Clave Maestra para acceder al Panel SuperAdmin y gestión de licencias (Ctrl+Shift+S)
SUPERADMIN_KEY=CAMBIA_ESTO_genera_con_pnpm_run_setup_secrets
# Clave API para webhooks entrantes (Make, Zapier, Google Sheets)
WEBHOOK_API_KEY=CAMBIA_ESTO_genera_con_pnpm_run_setup_secrets
# Clave simétrica para cifrado de respaldos locales y enviados a Telegram
BACKUP_ENCRYPTION_KEY=CAMBIA_ESTO_genera_con_pnpm_run_setup_secrets
ENABLE_GROUPS=false
# Número del dueño para comandos administrativos en WhatsApp (ej. 5215512345678)
WHATSAPP_OWNER_NUMBER=""

# ── MARCA BLANCA ──────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="BotMaRe AI"
NEXT_PUBLIC_SYSTEM_BRAND_NAME="BotMaRe"

# ── PROVEEDORES DE IA (Mínimo 1 requerido) ─────────────────────
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
SILICONFLOW_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
OLLAMA_API_URL="http://localhost:11434"

# Modelos recomendados
GROQ_MODEL="llama-3.1-8b-instant"
CEREBRAS_MODEL="llama3.1-8b"
SAMBANOVA_MODEL="Meta-Llama-3.1-8B-Instruct"
SILICONFLOW_MODEL="deepseek-ai/DeepSeek-V3"
MISTRAL_MODEL="mistral-small-latest"
TOGETHER_MODEL="meta-llama/Llama-3.3-70B-Instruct-Turbo"
OPENROUTER_MODEL="google/gemini-2.0-flash-lite-preview-02-05:free"
GEMINI_MODEL="gemini-2.5-flash"
DEEPSEEK_MODEL="deepseek-chat"
OPENAI_MODEL="gpt-4o-mini"
NVIDIA_MODEL="meta/llama3-70b-instruct"
OLLAMA_MODEL="qwen2.5:1.5b"

# ── GOOGLE INTEGRATION ─────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# ── TELEGRAM (Opcional) ───────────────────────────────────────
# Para control remoto y notificaciones de respaldo
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
NOTIFY_MODELS_TELEGRAM=false

# ── BASE DE DATOS HÍBRIDA ──────────────────────────────────────
# Motor de base de datos preferido: 'lowdb' o 'mongo'
DB_ENGINE=lowdb
# URL de conexión para MongoDB Atlas (Plan A)
# Si falla o no se configura, se usará lowdb localmente de forma automática.
MONGO_URI=tu_url_de_atlas_aqui

# ── API SMS (httpSMS) ─────────────────────────────────────────
# Variables necesarias para el envío de recordatorios y cargas masivas por SMS
HTTPSMS_API_KEY=tu_api_key_aqui
HTTPSMS_FROM_NUMBER=+521234567890
HTTPSMS_API_URL=https://api-sms.apptienda.site/v1/messages/send

# ── ACTUALIZACIONES Y AUTO-DEPLOY ─────────────────────────────
# Actualización y compilación automática al detectar nuevos commits en GitHub (false por defecto por seguridad)
AUTO_DEPLOY=false
# Secreto para proteger el webhook de GitHub (POST /api/webhooks/github)
GITHUB_WEBHOOK_SECRET=""
