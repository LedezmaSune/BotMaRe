# 🦊 BotMaRe AI - Plantilla de Configuración
# Copia este archivo como .env y rellena tus datos

# ── SISTEMA Y RED ──────────────────────────────────────────────
PORT=8000
DASHBOARD_URL=http://localhost:8000
# Si usas un túnel permanente (ej. Cloudflare Zero Trust) y no el Quick Tunnel temporal, pon el dominio aquí:
CUSTOM_DOMAIN=""
NODE_ENV=production
LOGGER_LEVEL=error

# ── SEGURIDAD DEL DASHBOARD Y ACCESOS ──────────────────────────
# Usuario y contraseña para acceder a la interfaz web (localhost:8000)
DASHBOARD_USER=admin
DASHBOARD_PASS=tu_contrasena_segura
ENABLE_GROUPS=false
# Número del dueño para comandos administrativos en WhatsApp (ej. 5215512345678)
WHATSAPP_OWNER_NUMBER=""

# ── MARCA BLANCA ──────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="BotMaRe AI"
NEXT_PUBLIC_SYSTEM_BRAND_NAME="BotMaRe"

# ── PROVEEDORES DE IA (Mínimo 1 requerido) ─────────────────────
# Rellena al menos una para que el bot pueda responder
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Modelos recomendados
# Groq es 100% gratuito por ahora y súper rápido. Llama 3.1 70B es su mejor opción.
GROQ_MODEL="llama-3.1-70b-versatile"

# OpenRouter: Google Gemma 2 9B (Gratis), alternativo Llama 3 8B
OPENROUTER_MODEL="google/gemma-2-9b-it:free"
# OPENROUTER_MODEL="meta-llama/llama-3-8b-instruct:free"

# Gemini: El modelo Flash tiene una capa gratuita mensual muy generosa y es rapidísimo.
GEMINI_MODEL="gemini-2.5-flash"

# DeepSeek: Súper económico, "deepseek-chat" es su modelo insignia.
DEEPSEEK_MODEL="deepseek-chat"

# OpenAI: No tiene capa gratuita, pero 4o-mini es extremadamente barato y capaz.
OPENAI_MODEL="gpt-4o-mini"

# NVIDIA NIM: Dan créditos gratis iniciales.
NVIDIA_MODEL="deepseek-ai/deepseek-v4-pro"

# ── TELEGRAM (Opcional) ───────────────────────────────────────
# Para control remoto y notificaciones de respaldo
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
NOTIFY_MODELS_TELEGRAM=false

# ── BASE DE DATOS HÍBRIDA ──────────────────────────────────────
# URL de conexión para MongoDB Atlas (Plan A)
# Si falla o no se configura, se usará lowdb localmente de forma automática.
MONGO_URI=tu_url_de_atlas_aqui

# ── API SMS (httpSMS) ─────────────────────────────────────────
# Variables necesarias para el envío de recordatorios y cargas masivas por SMS
HTTPSMS_API_KEY=tu_api_key_aqui
HTTPSMS_FROM_NUMBER=+521234567890
HTTPSMS_API_URL=https://api-sms.apptienda.online/v1/messages/send
