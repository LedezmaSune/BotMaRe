{
  "name": "botmare-dashboard",
  "version": "2.3.1",
  "description": "BotMaRe Dashboard Panel",
  "main": "src/server.ts",
  "scripts": {
    "dev": "concurrently -n \"ENGINE,UI\" -c \"bgBlue.bold,bgMagenta.bold\" \"tsx src/server.ts\" \"next dev --turbo\"",
    "clean": "rimraf out .next dist",
    "build": "pnpm run clean && next build --webpack",
    "start": "node bin/check-build.js && tsx src/server.ts",
    "setup": "node -e \"const fs=require('fs'); if(!fs.existsSync('.env')) fs.copyFileSync('.env.example', '.env')\" && pnpm install",
    "reset:wa": "rimraf data/whatsapp_auth.db auth_info_baileys",
    "tunnel": "cloudflared tunnel --url http://localhost:8000",
    "pm2:start": "node bin/check-build.js && pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs BotMaRe-Unified",
    "pm2:monit": "pm2 monit",
    "lint": "next lint",
    "menu": "node bin/launcher.js",
    "clean:logs": "node bin/clean-logs.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.23",
    "adm-zip": "^0.5.18",
    "api-dylux": "^1.8.6",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "better-sqlite3": "^12.11.1",
    "cloudflared": "^0.7.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "framer-motion": "^12.43.0",
    "google-tts-api": "^2.0.2",
    "googleapis": "^173.0.0",
    "grammy": "^1.45.1",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.2.0",
    "lowdb": "7.0.1",
    "lucide-react": "^1.31.0",
    "luxon": "^3.7.2",
    "mongoose": "^9.9.2",
    "multer": "^2.2.0",
    "next": "^16.2.11",
    "next-auth": "^4.24.15",
    "node-cron": "^4.6.0",
    "nprogress": "^0.2.0",
    "openai": "^6.49.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tunnelmole": "^2.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.4",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.5.26",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@whiskeysockets/baileys",
      "better-sqlite3",
      "cloudflared",
      "esbuild",
      "protobufjs",
      "sharp"
    ],
    "overrides": {
      "@whiskeysockets/baileys": "6.7.23",
      "axios": "^0.31.1"
    }
  }
}
